{
  "description": "Per-user sliding window: N allowed, isolation across users, exact window edge ages out",
  "limit": 3,
  "window_seconds": 60,
  "steps": [
    {
      "name": "alice_1_allowed",
      "action": {"action": "request", "user_id": "alice"},
      "expect": {
        "ok": true,
        "allowed": true,
        "status": 200,
        "count": 1,
        "remaining": 2
      }
    },
    {
      "name": "alice_2_allowed",
      "action": {"action": "request", "user_id": "alice"},
      "expect": {
        "ok": true,
        "allowed": true,
        "status": 200,
        "count": 2,
        "remaining": 1
      }
    },
    {
      "name": "alice_3_allowed_nth_must_pass",
      "action": {"action": "request", "user_id": "alice"},
      "expect": {
        "ok": true,
        "allowed": true,
        "status": 200,
        "count": 3,
        "remaining": 0
      }
    },
    {
      "name": "alice_4_blocked",
      "action": {"action": "request", "user_id": "alice"},
      "expect": {
        "ok": true,
        "allowed": false,
        "status": 429,
        "remaining": 0
      }
    },
    {
      "name": "bob_not_starved_by_alice",
      "action": {"action": "request", "user_id": "bob"},
      "expect": {
        "ok": true,
        "allowed": true,
        "status": 200,
        "user_id": "bob",
        "count": 1,
        "remaining": 2
      }
    },
    {
      "name": "advance_exact_window",
      "action": {"action": "advance", "seconds": 60},
      "expect": {"ok": true}
    },
    {
      "name": "alice_after_window_edge_must_allow",
      "action": {"action": "request", "user_id": "alice"},
      "expect": {
        "ok": true,
        "allowed": true,
        "status": 200,
        "user_id": "alice"
      }
    }
  ]
}
